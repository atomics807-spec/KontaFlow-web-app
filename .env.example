# =============================================================================
# KontaFlow — environment variable specification
# Copy to `.env.local` for local development. Never commit real credentials.
# Every variable below is validated at runtime (src/lib/env.ts). Values shown
# are placeholders, not working credentials.
# =============================================================================

# --- Application -------------------------------------------------------------
# Canonical public origin used for emails, OAuth redirects and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Runtime label surfaced in logs/metrics: development | preview | production.
APP_ENV="development"
# Deployment target adapter hint: vercel | cloudflare | node | local.
DEPLOYMENT_TARGET="local"
# Default locale for first-time visitors: en | fr | pcm.
NEXT_PUBLIC_DEFAULT_LOCALE="en"
# Optional Google Search Console verification token. Omit in local development.
GOOGLE_SITE_VERIFICATION=""

# --- Supabase ----------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Optional: internal Supabase origin used by server-side clients. In local
# preview containers, expose Supabase through /api/supabase and point
# NEXT_PUBLIC_SUPABASE_URL at that same-origin URL.
SUPABASE_INTERNAL_URL=""
# Public anon key (safe for the browser, guarded by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only service role key. Bypasses RLS: never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional direct Postgres connection used by migration/verification scripts.
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
# Optional: Supabase storage bucket for receipts and statements.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="kontaflow-documents"

# --- OpenAI (server-side only) ----------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
# Hard cost guardrails for the assistant.
AI_MAX_OUTPUT_TOKENS="900"
AI_MONTHLY_MESSAGE_QUOTA="300"

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="KontaFlow <notifications@kontaflow.com>"
EMAIL_REPLY_TO="support@kontaflow.com"
CONTACT_INBOX_EMAIL="info@kontaflow.com"

# --- USSD & SMS (Africa's Talking) ------------------------------------------
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""
# none | africastalking | console. `console` prints codes to server logs and is
# only acceptable for local development; production must use a real provider.
SMS_PROVIDER="none"
# Key used to HMAC six-digit OTPs before they reach Postgres. Falls back to the
# service-role key only to keep older deployments running; set a distinct value.
OTP_HMAC_SECRET=""
# USSD service code provisioned on the Africa's Talking short code.
USSD_SERVICE_CODE="*384*1234#"
# Required shared secret appended to the USSD callback URL (?token=...).
# Generate a random value; requests without it are rejected.
USSD_CALLBACK_TOKEN=""
# Sliding session lifetime. Keep it within the provider/aggregator limit.
USSD_SESSION_TTL_SECONDS="180"

# --- WhatsApp Business Platform (Meta Cloud API) ----------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="choose-a-long-random-string"
WHATSAPP_APP_SECRET=""
# Graph API version used for sends. Check Meta's changelog before upgrading.
WHATSAPP_GRAPH_VERSION="v27.0"
# Public business number shown in link instructions (E.164, e.g. +237...).
WHATSAPP_DISPLAY_PHONE_NUMBER=""
# Optional approved template for delivering a link code. Leave blank to show
# the code in the app only.
WHATSAPP_VERIFICATION_TEMPLATE_NAME=""
WHATSAPP_VERIFICATION_TEMPLATE_LANG="en_US"
# Approved template with five body parameters: workspace, period, income, expenses, net.
WHATSAPP_REPORT_TEMPLATE_NAME=""
WHATSAPP_REPORT_TEMPLATE_LANG="en_US"

# --- Payments ----------------------------------------------------------------
# disabled: no checkout. sandbox/production: use the provider's matching account.
# Payments are never simulated: without complete credentials the UI disables the
# provider and the API refuses to create a provider request.
PAYMENT_MODE="disabled"
# Optional allow-list: none offers every provider with complete credentials;
# mtn-momo, orange-money or aggregator narrows checkout to that one provider.
# stripe is reserved and currently disables mobile-money checkout.
PAYMENT_PROVIDER="none"

# MTN MoMo Collections (Cameroon). Apply for a Collections product subscription
# and create an API user/API key on the MTN developer portal. The sandbox and
# production callback hosts must be HTTPS.
MTN_MOMO_BASE_URL=""
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER_ID=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENV="mtncameroon"
# Optional: set only when the merchant/aggregator signs MTN callbacks. MTN's
# standard callback has no signature; KontaFlow always verifies the per-payment
# callback token and re-fetches the transaction status.
MTN_MOMO_WEBHOOK_SECRET=""
MTN_MOMO_SIGNATURE_HEADER="x-mtn-signature"

# Orange Money Web Payment (Cameroon). Obtain a merchant key and OAuth client
# from Orange Developer. The return/cancel URLs are built from NEXT_PUBLIC_APP_URL.
ORANGE_MONEY_BASE_URL="https://api.orange.com"
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_WEBPAY_PATH="/orange-money-webpay/cm/v1/webpayment"
ORANGE_MONEY_STATUS_PATH="/orange-money-webpay/cm/v1/transactionstatus"
ORANGE_MONEY_WEBHOOK_SECRET=""
ORANGE_MONEY_SIGNATURE_HEADER="x-orange-signature"
ORANGE_MONEY_LANG="en"

# Optional generic aggregator adapter. Contract: POST {base}{create_path} and
# GET {base}{status_path} with a bearer token; callbacks are HMAC-SHA256 signed
# over the raw body in the configured header. Keep empty unless the aggregator
# contract has been implemented and tested.
PAYMENT_API_BASE_URL=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_AGGREGATOR_CREATE_PATH="/payments"
PAYMENT_AGGREGATOR_STATUS_PATH="/payments/{id}"
PAYMENT_AGGREGATOR_REFUND_PATH="/refunds"
PAYMENT_AGGREGATOR_SIGNATURE_HEADER="x-kontaflow-signature"

# --- Webhooks & background jobs ---------------------------------------------
# Value of the `Authorization: Bearer <token>` header expected by /api/cron/*.
CRON_SECRET="generate-a-random-32-byte-string"
# Shared secret used to verify inbound sync requests from trusted devices.
SYNC_SHARED_SECRET=""

# --- Localization (Tolgee) ---------------------------------------------------
# Tolgee project used to manage translations. When credentials are absent the
# app falls back to the bundled dictionaries in src/lib/i18n/dictionaries.
NEXT_PUBLIC_TOLGEE_PROJECT_ID=""
TOLGEE_API_URL="https://app.tolgee.io"
TOLGEE_API_KEY=""

# --- Observability -----------------------------------------------------------
# Minimum level emitted by the structured logger: debug | info | warn | error.
LOG_LEVEL="info"
# Optional Sentry DSN placeholder for the observability adapter.
SENTRY_DSN=""

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AI_PER_MINUTE="20"
RATE_LIMIT_USSD_PER_MINUTE="30"
RATE_LIMIT_WHATSAPP_PER_MINUTE="30"
RATE_LIMIT_WEBHOOK_PER_MINUTE="120"

# --- Security hardening ------------------------------------------------------
# Extra browser origins allowed to invoke Server Actions, comma separated.
# Keep empty when the app is served on its own host. Preview proxies that
# rewrite the Host header need their public host listed here.
TRUSTED_ORIGINS=""
# Browser session lifetime. Supabase refresh tokens can live longer; this
# cookie cap is what ends an idle browser session.
SESSION_COOKIE_MAX_AGE_SECONDS="604800"
# Optional malware scanner for uploads. The adapter POSTs multipart/form-data
# with a `file` field and expects {"clean": true|false, "reason"?: string}.
# disabled | warn | enforce. `enforce` fails closed when the scanner is down.
MALWARE_SCAN_MODE="disabled"
MALWARE_SCAN_URL=""
MALWARE_SCAN_API_KEY=""
RATE_LIMIT_UPLOAD_PER_MINUTE="20"
RATE_LIMIT_SYNC_PER_MINUTE="60"
RATE_LIMIT_EXPORT_PER_MINUTE="10"
